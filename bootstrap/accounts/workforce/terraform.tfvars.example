# Copy to terraform.tfvars (gitignored) for a local run. CI sets region and state_bucket_name from its environment.
region            = "<region>"
state_bucket_name = "<state-bucket-name>"

# Only for the one-time bootstrap, never in CI: the workforce account ID.
# break_glass_account_id = "<12 digits>"

# The CDK deployment of workforce-pipeline (docs/CDK_BOOTSTRAP.md). Leave unset until the repository exists.
# pipeline = {
#   github_repository_id = "<numeric GitHub ID of workforce-pipeline>"
# }
