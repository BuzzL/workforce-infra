# Copy to terraform.tfvars (gitignored) for a local run. CI sets region and state_bucket_name from its environment.
region            = "<region>"
state_bucket_name = "<state-bucket-name>"

# Only for the one-time bootstrap, never in CI: the test account ID.
# break_glass_account_id = "<12 digits>"

# The agent role (docs/AGENT_ROLES.md). Leave unset until the agent task role exists in workforce.
# agent = {
#   principal_arn        = "arn:aws:iam::<workforce account id>:role/<agent task role>"
#   workforce_account_id = "<workforce account id>"
#   external_ids         = ["<ExternalId of this environment>"]
# }
