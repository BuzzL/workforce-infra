# Copy to terraform.tfvars (gitignored) for a local run. CI sets region from its environment.
region = "<region>"

maintainer_username    = "<identity-center-user-name>"
assignment_account_ids = { security = "<12 digits>", workforce = "<12 digits>" }

# Audit log archive (docs/AUDIT_LOGGING.md). Leave unset to keep it off.
# audit_log_bucket_name = "<unique-bucket-name>"
# organization_id       = "o-xxxxxxxxxx"
# management_account_id = "<12 digits>"
